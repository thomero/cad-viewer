{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CAD Viewer",
  "version": "0.1.0",
  "identifier": "com.moudourossoftware.cadviewer",
  "build": {
    "beforeBuildCommand": "pnpm --dir ../.. --filter @mlightcad/cad-viewer-example build",
    "frontendDist": "../../cad-viewer-example/dist"
  },
  "app": {
    "windows": [
      {
        "title": "CAD Viewer",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
